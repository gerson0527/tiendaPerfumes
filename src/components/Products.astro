---
import { products } from '../data/products';
---
<section class="products-section" id="products">
  <div class="section-header reveal">
    <div>
      <span class="section-tag">NUESTRO CATÁLOGO</span>
      <h2 class="section-title">Lociones de<br><em>Alta Gama</em></h2>
    </div>
    <p class="section-sub">Explora nuestra colección selecta de perfumes corporales de autor. Filtra por aromas, precios o colecciones especiales para encontrar tu ritual ideal.</p>
  </div>

  <!-- ── LUXURY CATALOG SPLIT LAYOUT ── -->
  <div class="catalog-layout reveal reveal-delay-1">
    
    <!-- ── LEFT SIDEBAR: FILTERS ── -->
    <aside class="filter-sidebar" aria-label="Filtros de catálogo">
      
      <!-- Group 1: Search & Autocomplete -->
      <div class="filter-group">
        <span class="filter-label">BUSCAR FRAGANCIA</span>
        <div class="search-wrapper" id="searchWrapper">
          <svg class="search-icon" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="filterSearch" placeholder="Buscar por nombre, notas..." aria-label="Buscar lociones" autocomplete="off" />
          
          <!-- CLEAR SEARCH BUTTON -->
          <button id="clearSearchBtn" class="clear-search-btn" aria-label="Limpiar búsqueda" type="button">
            <svg viewBox="0 0 24 24" width="14" height="14">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
          
          <!-- DYNAMIC FLOATING AUTOCOMPLETE DROPDOWN -->
          <div class="search-autocomplete-dropdown" id="searchAutocomplete" role="listbox"></div>
        </div>
      </div>
      
      <!-- Group 2: Sort dropdown -->
      <div class="filter-group">
        <span class="filter-label">ORDENAR POR</span>
        <select id="filterSort" aria-label="Criterio de ordenación">
          <option value="default">Predeterminado</option>
          <option value="price-asc">Precio: Menor a Mayor</option>
          <option value="price-desc">Precio: Mayor a Menor</option>
          <option value="name-asc">Nombre: A - Z</option>
        </select>
      </div>

      <!-- Group 3: Collection Buttons -->
      <div class="filter-group">
        <span class="filter-label">COLECCIÓN</span>
        <div class="filter-buttons vertical-buttons" id="collectionFilters">
          <button class="filter-btn active" data-collection="all">TODOS LOS PRODUCTOS</button>
          <button class="filter-btn" data-collection="BESTSELLER">BESTSELLERS</button>
          <button class="filter-btn" data-collection="NUEVO">NUEVAS LLEGADAS</button>
          <button class="filter-btn" data-collection="EDICIÓN LIMITADA">EDICIONES LIMITADAS</button>
        </div>
      </div>

      <!-- Group 4: Olfactory Family Buttons -->
      <div class="filter-group">
        <span class="filter-label">FAMILIA OLFATIVA</span>
        <div class="filter-buttons vertical-buttons" id="familyFilters">
          <button class="tag-btn active" data-family="all">TODAS LAS FAMILIAS</button>
          <button class="tag-btn" data-family="Amaderado">AMADERADOS</button>
          <button class="tag-btn" data-family="Floral">FLORALES</button>
          <button class="tag-btn" data-family="Oriental">ORIENTALES</button>
          <button class="tag-btn" data-family="Cítrico">CÍTRICOS</button>
          <button class="tag-btn" data-family="Dulce">DULCES</button>
        </div>
      </div>

      <!-- Group 5: Price Range Slider -->
      <div class="filter-group price-group">
        <div class="price-header">
          <span class="filter-label">PRECIO MÁXIMO</span>
          <span class="price-badge" id="priceBadge">$120</span>
        </div>
        <input type="range" id="filterPrice" min="70" max="120" value="120" step="1" aria-label="Filtrar por precio máximo" />
        <div class="range-labels">
          <span>$70</span>
          <span>$120</span>
        </div>
      </div>
      
    </aside>

    <!-- ── RIGHT SIDE: DYNAMIC CATALOG GRID ── -->
    <div class="products-grid-container" id="productsContainer" data-products={JSON.stringify(products)}>
      <div class="products-grid" id="catalogGrid">
        {products.map((product, idx) => {
          const thumbnailImage = product.image.replace('w=600', 'w=200').replace('q=85', 'q=80');
          const delayClass = `reveal-delay-${(idx % 3) + 1}`;
          
          return (
            <div 
              class={`product-card reveal ${delayClass}`}
              data-id={product.id}
              data-name={product.name}
              data-price={product.price}
              data-img={thumbnailImage}
              data-notas={product.notes.join(' · ')}
              data-badge={product.badge || ''}
              data-family={product.family}
            >
              <div class="product-img">
                <span class="product-number">N°{product.id}</span>
                {product.badge && <span class="product-badge">{product.badge}</span>}
                <img src={product.image} alt={product.name} loading="lazy" />
                <div class="product-img-overlay"></div>
              </div>
              <div class="product-info">
                <h3 class="product-name">{product.name}</h3>
                <p class="product-desc">{product.description}</p>
                <div class="product-notes">
                  {product.notes.map((note) => (
                    <span class="note-tag">{note}</span>
                  ))}
                </div>
                <div class="product-footer">
                  <span class="product-price">${product.price}</span>
                  <button class="add-btn">COMPRAR</button>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty State Placeholder -->
      <div class="empty-state" id="catalogEmptyState">
        <div class="empty-icon">🌿</div>
        <h3>No se encontraron fragancias</h3>
        <p>Prueba ajustando los filtros o realizando otra búsqueda en nuestra colección de autor.</p>
        <button class="btn-reset" id="btnResetFilters">RESTAURAR FILTROS</button>
      </div>
    </div>
    
  </div>

  <!-- ── LUXURY PRODUCT DETAIL MODAL ── -->
  <div class="product-modal-backdrop" id="productModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="product-modal-container">
      <button class="popup-close-btn" id="modalCloseBtn" aria-label="Cerrar modal">
        <span>CERRAR</span>
        <svg viewBox="0 0 24 24" width="14" height="14">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      
      <div class="product-modal-content">
        <!-- Left: Image Gallery Showcase -->
        <div class="modal-gallery-column">
          <div class="modal-main-image-wrapper">
            <button class="popup-arrow-btn prev" id="galleryPrevBtn" aria-label="Imagen anterior">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            
            <img id="modalMainImg" src="" alt="Perfume principal" />
            
            <button class="popup-arrow-btn next" id="galleryNextBtn" aria-label="Siguiente imagen">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
          
          <!-- Thumbnails grid -->
          <div class="modal-thumbnails-grid" id="modalThumbnails">
            <!-- Dynamically populated via script -->
          </div>
        </div>
        
        <!-- Right: Boutique Specifications -->
        <div class="modal-details-column">
          <div class="modal-details-header">
            <span class="modal-badge" id="modalBadge">BESTSELLER</span>
            <span class="modal-family" id="modalFamily">ORIENTAL</span>
          </div>
          
          <h2 class="modal-product-title" id="modalTitle">Noir de Minuit</h2>
          <p class="modal-product-desc" id="modalDesc">Una noche de oud y vainilla...</p>
          
          <!-- Scent notes -->
          <div class="modal-notes-section">
            <span class="modal-section-label">PERFIL AROMÁTICO</span>
            <div class="modal-notes-tags" id="modalNotesTags">
              <!-- Dynamically populated via script -->
            </div>
          </div>
          
          <div class="modal-divider"></div>
          
          <!-- Performance Specs -->
          <div class="modal-performance-section">
            <span class="modal-section-label">ESPECIFICACIONES TÉCNICAS</span>
            
            <!-- Longevity -->
            <div class="perf-metric">
              <div class="perf-metric-header">
                <span>Longevidad / Duración</span>
                <span class="perf-metric-val" id="metricLongevityVal">Extrema (9-11h)</span>
              </div>
              <div class="perf-metric-bar-wrapper">
                <div class="perf-metric-bar" id="metricLongevityBar" style="width: 95%;"></div>
              </div>
            </div>

            <!-- Projection -->
            <div class="perf-metric">
              <div class="perf-metric-header">
                <span>Proyección / Estela</span>
                <span class="perf-metric-val" id="metricProjectionVal">Estela Pesada</span>
              </div>
              <div class="perf-metric-bar-wrapper">
                <div class="perf-metric-bar" id="metricProjectionBar" style="width: 85%;"></div>
              </div>
            </div>
            
            <!-- Times and Seasons -->
            <div class="perf-context-tags">
              <div class="context-tag">
                <span class="context-icon">⏱️</span>
                <div class="context-text">
                  <span class="context-label">Uso Recomendado</span>
                  <span class="context-val" id="metricIdealTime">Noche / Gala</span>
                </div>
              </div>
              <div class="context-tag">
                <span class="context-icon">🍂</span>
                <div class="context-text">
                  <span class="context-label">Estación Ideal</span>
                  <span class="context-val" id="metricSeason">Otoño / Invierno</span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="modal-divider"></div>
          
          <!-- Modal Action footer -->
          <div class="modal-action-footer">
            <div class="modal-price-wrapper">
              <span class="modal-price-label">PRECIO EXCLUSIVO</span>
              <span class="modal-price-val" id="modalPrice">$85</span>
            </div>
            <button class="modal-buy-btn" id="modalBuyBtn">AÑADIR AL CARRITO</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── SECTION HEADER ── */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
  }
  
  .section-tag {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 11px;
    letter-spacing: .45em;
    color: var(--gold);
    display: block;
    margin-bottom: 10px;
  }
  
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 58px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.05;
    color: var(--white);
  }
  
  .section-sub {
    font-size: 15px;
    color: var(--muted);
    max-width: 420px;
    line-height: 1.7;
    font-weight: 300;
    text-align: right;
  }

  /* ── PRODUCTS MAIN CONTAINER ── */
  .products-section {
    padding: 90px 48px 100px;
    background: var(--dark);
    position: relative;
    min-height: 100vh;
  }
  
  .products-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  /* ── LUXURY CATALOG SPLIT LAYOUT ── */
  .catalog-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    align-items: start;
    position: relative;
  }

  /* ── LEFT SIDEBAR: STICKY FILTERS ── */
  .filter-sidebar {
    background: rgba(22, 22, 22, 0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(201, 169, 110, 0.12);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.03);
    padding: 36px 30px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    position: sticky;
    top: 130px; /* Floats beautifully under the fixed Header */
    max-height: calc(100vh - 170px);
    overflow-y: auto;
  }

  .filter-sidebar::-webkit-scrollbar {
    width: 2px;
  }

  .filter-sidebar::-webkit-scrollbar-thumb {
    background: var(--gold);
    border-radius: 1px;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .filter-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 12px;
    letter-spacing: .25em;
    color: var(--gold);
    text-transform: uppercase;
    opacity: 0.95;
  }

  /* Search bar inside sidebar */
  .search-wrapper {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 15px;
    height: 15px;
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    pointer-events: none;
    transition: stroke .3s, transform .3s;
  }

  #filterSearch {
    width: 100%;
    background: rgba(8, 8, 8, 0.6);
    border: 1px solid var(--border);
    padding: 13px 40px 13px 44px; /* Increased right padding to 40px for clear button */
    font-family: 'Geist', sans-serif;
    font-size: 14px;
    font-style: normal;
    color: var(--white);
    outline: none;
    transition: border-color .4s, box-shadow .4s, background .4s;
    letter-spacing: 0.02em;
  }

  #filterSearch:focus {
    border-color: var(--gold);
    background: rgba(8, 8, 8, 0.85);
    box-shadow: 0 0 15px rgba(201, 169, 110, 0.08);
  }

  #filterSearch:focus + .search-icon {
    stroke: var(--gold);
    transform: translateY(-50%) scale(1.1);
  }

  /* ── PREMIUM AUTOCOMPLETE DROPDOWN PANEL ── */
  .search-autocomplete-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: rgba(15, 15, 15, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(201, 169, 110, 0.15);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
    z-index: 100;
    max-height: 280px;
    overflow-y: auto;
    display: none;
    border-radius: 4px;
  }

  .search-autocomplete-dropdown::-webkit-scrollbar {
    width: 2px;
  }

  .search-autocomplete-dropdown::-webkit-scrollbar-thumb {
    background: var(--gold);
  }

  @keyframes dropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .search-autocomplete-dropdown.show {
    display: block;
    animation: dropdownFadeIn 0.3s cubic-bezier(.16, 1, .3, 1) both;
  }

  .autocomplete-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    cursor: none;
    transition: background 0.25s, padding-left 0.25s;
  }

  .autocomplete-item:last-child {
    border-bottom: none;
  }

  .autocomplete-item:hover,
  .autocomplete-item.active {
    background: rgba(201, 169, 110, 0.08);
    padding-left: 20px;
  }

  .autocomplete-img {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    object-fit: cover;
    filter: brightness(0.9);
  }

  .autocomplete-info {
    flex: 1;
    min-width: 0;
  }

  .autocomplete-name {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--white);
    display: block;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .autocomplete-meta {
    font-size: 10px;
    color: var(--muted);
    font-family: 'Geist', sans-serif;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .autocomplete-price {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    color: var(--gold);
    font-weight: 700;
  }

  .autocomplete-no-results {
    padding: 16px;
    text-align: center;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 14px;
    color: var(--muted);
  }

  /* Clear search button styling */
  .clear-search-btn {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: none;
    color: var(--muted);
    opacity: 0;
    visibility: hidden;
    transition: opacity .3s, color .3s, transform .3s, visibility .3s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    z-index: 10;
  }

  .clear-search-btn.show {
    opacity: 1;
    visibility: visible;
  }

  .clear-search-btn:hover {
    color: var(--gold);
    transform: translateY(-50%) scale(1.1);
  }

  .clear-search-btn svg {
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  /* Highlight matching search terms */
  .search-highlight {
    color: var(--gold-light);
    font-weight: 700;
    text-shadow: 0 0 10px rgba(232, 213, 163, 0.45);
  }

  /* Sort dropdown inside sidebar */
  #filterSort {
    width: 100%;
    background: rgba(8, 8, 8, 0.6);
    border: 1px solid var(--border);
    color: var(--white);
    font-family: 'Geist', sans-serif;
    font-size: 13px;
    font-style: normal;
    padding: 13px 20px;
    outline: none;
    cursor: none;
    transition: border-color .3s, background .3s;
  }

  #filterSort:hover, #filterSort:focus {
    border-color: var(--gold);
    background: rgba(8, 8, 8, 0.9);
  }

  #filterSort option {
    background: var(--black);
    color: var(--white);
    padding: 12px;
  }

  /* Vertical list filter buttons */
  .vertical-buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    width: 100%;
  }

  .vertical-buttons .filter-btn,
  .vertical-buttons .tag-btn {
    text-align: left;
    width: 100%;
    padding: 12px 18px;
    font-size: 11px;
  }

  /* Filter Buttons standard styling */
  .filter-btn {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 11px;
    letter-spacing: .22em;
    background: rgba(8, 8, 8, 0.4);
    color: var(--muted);
    border: 1px solid var(--border);
    cursor: none;
    transition: all .4s cubic-bezier(.16, 1, .3, 1);
  }

  .filter-btn:hover {
    color: var(--white);
    border-color: var(--gold);
    padding-left: 22px; /* Micro sliding visual effect on hover */
  }

  .filter-btn.active {
    color: var(--black);
    background: var(--gold);
    border-color: var(--gold);
    box-shadow: 0 0 15px rgba(201, 169, 110, 0.15);
    padding-left: 22px;
  }

  /* Tag filter buttons for note families */
  .tag-btn {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 11px;
    letter-spacing: .2em;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
    cursor: none;
    transition: all .4s cubic-bezier(.16, 1, .3, 1);
  }

  .tag-btn:hover {
    color: var(--gold-light);
    border-color: var(--gold);
    padding-left: 22px;
  }

  .tag-btn.active {
    color: var(--gold-light);
    border-color: var(--gold);
    background: rgba(201, 169, 110, 0.08);
    box-shadow: inset 0 0 10px rgba(201, 169, 110, 0.05);
    padding-left: 22px;
  }

  /* Price Range Slider */
  .price-group {
    width: 100%;
  }

  .price-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .price-badge {
    font-family: 'Space Mono', monospace;
    font-size: 14px;
    color: var(--gold);
    font-weight: 700;
    text-shadow: 0 0 8px rgba(201, 169, 110, 0.3);
  }

  #filterPrice {
    -webkit-appearance: none;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--gold) 0%, var(--border) 100%);
    outline: none;
    cursor: none;
    margin: 12px 0 8px;
  }

  #filterPrice::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--black);
    border: 2px solid var(--gold);
    box-shadow: 0 0 8px rgba(201, 169, 110, 0.6);
    transition: transform .2s, border-color .2s;
  }

  #filterPrice::-webkit-slider-thumb:hover {
    transform: scale(1.25);
    border-color: var(--gold-light);
  }

  .range-labels {
    display: flex;
    justify-content: space-between;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    opacity: 0.8;
  }

  /* ── RIGHT COLUMN: DYNAMIC GRID ── */
  .products-grid-container {
    position: relative;
    min-height: 400px;
    flex: 1;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr); /* Editorial 5-column layout for boutique display */
    gap: 20px; /* Incrementado de 2px a 20px para dar aire y separación de lujo */
    transition: opacity .3s;
  }

  .product-card {
    background: var(--card);
    position: relative;
    overflow: hidden;
    cursor: none;
    transition: transform .4s cubic-bezier(.16, 1, .3, 1), opacity .3s, visibility .3s;
  }

  .product-card.hidden {
    display: none !important;
  }
  
  .product-card:hover {
    transform: translateY(-6px);
  }
  
  .product-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
  }
  
  .product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(.16, 1, .3, 1), filter .5s;
    filter: brightness(.8) saturate(.7);
  }
  
  .product-card:hover .product-img img {
    transform: scale(1.08);
    filter: brightness(.9) saturate(1);
  }
  
  .product-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(8, 8, 8, .9));
    pointer-events: none;
  }
  
  .product-number {
    position: absolute;
    top: 16px;
    left: 16px;
