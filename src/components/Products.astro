<!-- ── CLIENT SIDE FILTERING & AUTOCOMPLETE CONTROLLER ── -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('catalogGrid') as HTMLElement;
    const cards = Array.from(document.querySelectorAll('.product-card')) as HTMLElement[];
    const searchInput = document.getElementById('filterSearch') as HTMLInputElement;
    const sortSelect = document.getElementById('filterSort') as HTMLSelectElement;
    const priceSlider = document.getElementById('filterPrice') as HTMLInputElement;
    const priceBadge = document.getElementById('priceBadge') as HTMLElement;
    const collectionButtons = document.querySelectorAll('#collectionFilters .filter-btn');
    const familyButtons = document.querySelectorAll('#familyFilters .tag-btn');
    const emptyState = document.getElementById('catalogEmptyState') as HTMLElement;
    const resetBtn = document.getElementById('btnResetFilters') as HTMLButtonElement;

    // Autocomplete dropdown elements
    const searchWrapper = document.getElementById('searchWrapper') as HTMLElement;
    const searchAutocomplete = document.getElementById('searchAutocomplete') as HTMLElement;
    const clearSearchBtn = document.getElementById('clearSearchBtn') as HTMLButtonElement;

    // Safely parse the products catalog list in client script
    const container = document.getElementById('productsContainer') as HTMLElement;
    interface ProductData {
      id: string;
      name: string;
      price: number;
      image: string;
      images: string[];
      badge?: string;
      description: string;
      notes: string[];
      family: string;
      details: {
        longevity: string;
        projection: string;
        idealTime: string;
        season: string;
      };
    }
    const allProducts: ProductData[] = JSON.parse(container?.dataset.products || '[]');

    // Active state filter states
    let activeCollection = 'all';
    let activeFamily = 'all';
    let focusedSuggestionIndex = -1;

    // Acentuación y mayúsculas insensibles (Normalizador para búsquedas más naturales)
    const cleanStr = (str: string) => str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

    // Helper to highlight matched query in text
    const highlightMatch = (text: string, query: string): string => {
      if (!query) return text;
      const cleanText = cleanStr(text);
      const cleanQuery = cleanStr(query);
      const index = cleanText.indexOf(cleanQuery);
      
      if (index === -1) return text;
      
      const before = text.substring(0, index);
      const match = text.substring(index, index + query.length);
      const after = text.substring(index + query.length);
      return `${before}<strong class="search-highlight">${match}</strong>${after}`;
    };

    // Helper to toggle close/clear button visibility
    const toggleClearButton = () => {
      if (clearSearchBtn) {
        if (searchInput.value.length > 0) {
          clearSearchBtn.classList.add('show');
        } else {
          clearSearchBtn.classList.remove('show');
        }
      }
    };

    // 1. DYNAMIC MAIN FILTER FUNCTION
    const filterProducts = () => {
      const query = cleanStr(searchInput.value.trim());
      const maxPrice = parseInt(priceSlider.value);
      
      let visibleCount = 0;

      cards.forEach(card => {
        const name = cleanStr(card.dataset.name || '');
        const price = parseInt(card.dataset.price || '0');
        const badge = card.dataset.badge || '';
        const family = card.dataset.family || '';
        const notes = cleanStr(card.dataset.notas || '');

        // Check search matching (name or olfactory notes)
        const matchesSearch = name.includes(query) || notes.includes(query);
        
        // Check collection/badge matching
        const matchesCollection = activeCollection === 'all' || badge === activeCollection;
        
        // Check olfactory family matching
        const matchesFamily = activeFamily === 'all' || family === activeFamily;
        
        // Check price matching
        const matchesPrice = price <= maxPrice;

        if (matchesSearch && matchesCollection && matchesFamily && matchesPrice) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update empty state display
      if (visibleCount === 0) {
        emptyState.classList.add('show');
        grid.style.display = 'none';
      } else {
        emptyState.classList.remove('show');
        grid.style.display = 'grid';
      }
    };

    // 2. SORT FUNCTION
    const sortProducts = () => {
      const method = sortSelect.value;
      
      if (method === 'default') {
        cards.sort((a, b) => {
          const idA = parseInt(a.dataset.id || '0');
          const idB = parseInt(b.dataset.id || '0');
          return idA - idB;
        });
      } else if (method === 'price-asc') {
        cards.sort((a, b) => {
          const priceA = parseInt(a.dataset.price || '0');
          const priceB = parseInt(b.dataset.price || '0');
          return priceA - priceB;
        });
      } else if (method === 'price-desc') {
        cards.sort((a, b) => {
          const priceA = parseInt(a.dataset.price || '0');
          const priceB = parseInt(b.dataset.price || '0');
          return priceB - priceA;
        });
      } else if (method === 'name-asc') {
        cards.sort((a, b) => {
          const nameA = a.dataset.name || '';
          const nameB = b.dataset.name || '';
          return nameA.localeCompare(nameB);
        });
      }

      cards.forEach(card => {
        grid.appendChild(card);
      });
    };

    // 3. AUTOCOMPLETE CONTROLLER FUNCTIONS
    const showAutocomplete = () => {
      const query = searchInput.value.toLowerCase().trim();
      
      if (query.length === 0) {
        hideAutocomplete();
        return;
      }

      const cleanQuery = cleanStr(query);

      // Filter matches
      const matches = allProducts.filter(p => 
        cleanStr(p.name).includes(cleanQuery) || 
        p.notes.some(n => cleanStr(n).includes(cleanQuery)) ||
        cleanStr(p.family).includes(cleanQuery)
      );

      if (matches.length === 0) {
        searchAutocomplete.innerHTML = `<div class="autocomplete-no-results">Sin sugerencias para "${query}"</div>`;
      } else {
        // Render suggested product nodes with golden highlights
        searchAutocomplete.innerHTML = matches.map((p, idx) => {
          const highlightedName = highlightMatch(p.name, query);
          const highlightedFamily = highlightMatch(p.family, query);
          const highlightedNotes = p.notes
            .map(n => highlightMatch(n, query))
            .slice(0, 3)
            .join(' · ');

          return `
            <div class="autocomplete-item" role="option" data-name="${p.name}" data-idx="${idx}" id="suggestion-${idx}">
              <img class="autocomplete-img" src="${p.image.replace('w=600', 'w=200')}" alt="${p.name}">
              <div class="autocomplete-info">
                <span class="autocomplete-name">${highlightedName}</span>
                <span class="autocomplete-meta">${highlightedFamily} · ${highlightedNotes}</span>
              </div>
              <span class="autocomplete-price">$${p.price}</span>
            </div>
          `;
        }).join('');

        // Bind clicks directly to items
        searchAutocomplete.querySelectorAll('.autocomplete-item').forEach(item => {
          item.addEventListener('click', (e) => {
            const el = e.currentTarget as HTMLElement;
            selectSuggestion(el.dataset.name || '');
          });
        });
      }

      searchAutocomplete.classList.add('show');
      focusedSuggestionIndex = -1; // Reset keyboard focus
    };

    const hideAutocomplete = () => {
      searchAutocomplete.classList.remove('show');
      focusedSuggestionIndex = -1;
    };

    const selectSuggestion = (name: string) => {
      searchInput.value = name;
      toggleClearButton();
      hideAutocomplete();

      // SMART AUTO-RESET: Adjusts overlapping filters so the chosen perfume shows up immediately
      const selectedProduct = allProducts.find(p => p.name === name);
      if (selectedProduct) {
        // A. Reset collection filter if active and conflicting
        if (activeCollection !== 'all' && selectedProduct.badge !== activeCollection) {
          activeCollection = 'all';
          collectionButtons.forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-collection') === 'all');
          });
        }

        // B. Reset olfactory family filter if active and conflicting
        if (activeFamily !== 'all' && selectedProduct.family !== activeFamily) {
          activeFamily = 'all';
          familyButtons.forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-family') === 'all');
          });
        }

        // C. Adjust price slider if product is more expensive
        const currentSliderVal = parseInt(priceSlider.value);
        if (selectedProduct.price > currentSliderVal) {
          priceSlider.value = selectedProduct.price.toString();
          if (priceBadge) {
            priceBadge.textContent = `$${selectedProduct.price}`;
          }
        }
      }

      filterProducts();
    };

    const highlightSuggestion = (direction: 'up' | 'down') => {
      const items = Array.from(searchAutocomplete.querySelectorAll('.autocomplete-item')) as HTMLElement[];
      if (items.length === 0) return;

      // Remove previous active highlights
      items.forEach(i => i.classList.remove('active'));

      if (direction === 'down') {
        focusedSuggestionIndex = (focusedSuggestionIndex + 1) % items.length;
      } else {
        focusedSuggestionIndex = (focusedSuggestionIndex - 1 + items.length) % items.length;
      }

      const activeItem = items[focusedSuggestionIndex];
      if (activeItem) {
        activeItem.classList.add('active');
        activeItem.scrollIntoView({ block: 'nearest' });
        // Set aria-activedescendant for screen readers
        searchInput.setAttribute('aria-activedescendant', activeItem.id);
      }
    };

    // 4. BINDING TRIGGERS & LISTENERS
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        filterProducts();
        showAutocomplete();
        toggleClearButton();
      });

      searchInput.addEventListener('focus', showAutocomplete);

      // KEYBOARD NAVIGATION HANDLERS (Premium Access UX)
      searchInput.addEventListener('keydown', (e) => {
        const isDropdownOpen = searchAutocomplete.classList.contains('show');
        
        if (e.key === 'ArrowDown') {
          if (!isDropdownOpen) {
            showAutocomplete();
          } else {
            e.preventDefault();
            highlightSuggestion('down');
          }
        } else if (e.key === 'ArrowUp') {
          if (isDropdownOpen) {
            e.preventDefault();
            highlightSuggestion('up');
          }
        } else if (e.key === 'Enter') {
          if (isDropdownOpen) {
            e.preventDefault();
            if (focusedSuggestionIndex >= 0) {
              const activeItem = searchAutocomplete.querySelector('.autocomplete-item.active') as HTMLElement;
              if (activeItem) {
                selectSuggestion(activeItem.dataset.name || '');
              }
            } else {
              hideAutocomplete();
            }
          }
        } else if (e.key === 'Escape') {
          hideAutocomplete();
        }
      });
    }

    // Hide dropdown when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (searchWrapper && !searchWrapper.contains(target)) {
        hideAutocomplete();
      }
    });

    // Clear search button binding
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        toggleClearButton();
        filterProducts();
        hideAutocomplete();
        searchInput.focus();
      });
    }

    // Sort listener
    if (sortSelect) {
      sortSelect.addEventListener('change', sortProducts);
    }

    // Price Slider listener
    if (priceSlider && priceBadge) {
      priceSlider.addEventListener('input', () => {
        priceBadge.textContent = `$${priceSlider.value}`;
        filterProducts();
      });
    }

    // Collection buttons triggers
    collectionButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLButtonElement;
        collectionButtons.forEach(b => b.classList.remove('active'));
        el.classList.add('active');
        activeCollection = el.dataset.collection || 'all';
        filterProducts();
      });
    });

    // Family buttons triggers
    familyButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLButtonElement;
        familyButtons.forEach(b => b.classList.remove('active'));
        el.classList.add('active');
        activeFamily = el.dataset.family || 'all';
        filterProducts();
      });
    });

    // Reset Filters trigger
    const resetFilters = () => {
      searchInput.value = '';
      toggleClearButton();
      priceSlider.value = '120';
      priceBadge.textContent = '$120';
      
      collectionButtons.forEach(b => b.classList.remove('active'));
      const defaultCollectionBtn = document.querySelector('[data-collection="all"]');
      if (defaultCollectionBtn) defaultCollectionBtn.classList.add('active');
      activeCollection = 'all';

      familyButtons.forEach(b => b.classList.remove('active'));
      const defaultFamilyBtn = document.querySelector('[data-family="all"]');
      if (defaultFamilyBtn) defaultFamilyBtn.classList.add('active');
      activeFamily = 'all';

      sortSelect.value = 'default';
      
      sortProducts();
      filterProducts();
      hideAutocomplete();
    };

    if (resetBtn) resetBtn.addEventListener('click', resetFilters);

    // ── 5. LUXURY DETAIL MODAL CONTROLLER ──
    const productModal = document.getElementById('productModal') as HTMLElement;
    const modalCloseBtn = document.getElementById('modalCloseBtn') as HTMLButtonElement;
    const modalMainImg = document.getElementById('modalMainImg') as HTMLImageElement;
    const galleryPrevBtn = document.getElementById('galleryPrevBtn') as HTMLButtonElement;
    const galleryNextBtn = document.getElementById('galleryNextBtn') as HTMLButtonElement;
    const modalThumbnails = document.getElementById('modalThumbnails') as HTMLElement;

    const modalBadge = document.getElementById('modalBadge') as HTMLElement;
    const modalFamily = document.getElementById('modalFamily') as HTMLElement;
    const modalTitle = document.getElementById('modalTitle') as HTMLElement;
    const modalDesc = document.getElementById('modalDesc') as HTMLElement;
    const modalNotesTags = document.getElementById('modalNotesTags') as HTMLElement;

    const metricLongevityVal = document.getElementById('metricLongevityVal') as HTMLElement;
    const metricLongevityBar = document.getElementById('metricLongevityBar') as HTMLElement;
    const metricProjectionVal = document.getElementById('metricProjectionVal') as HTMLElement;
    const metricProjectionBar = document.getElementById('metricProjectionBar') as HTMLElement;
    const metricIdealTime = document.getElementById('metricIdealTime') as HTMLElement;
    const metricSeason = document.getElementById('metricSeason') as HTMLElement;

    const modalPrice = document.getElementById('modalPrice') as HTMLElement;
    const modalBuyBtn = document.getElementById('modalBuyBtn') as HTMLButtonElement;

    let modalImages: string[] = [];
    let currentModalImgIdx = 0;

    const openProductModal = (id: string) => {
      const product = allProducts.find(p => p.id === id);
      if (!product) return;

      // Reset gallery state
      modalImages = product.images || [product.image];
      currentModalImgIdx = 0;
      updateModalGallery();

      // Populate text details
      if (modalBadge) {
        modalBadge.textContent = product.badge || '';
        modalBadge.style.display = product.badge ? 'block' : 'none';
      }
      if (modalFamily) modalFamily.textContent = product.family;
      if (modalTitle) modalTitle.textContent = product.name;
      if (modalDesc) modalDesc.textContent = product.description;

      // Populate notes tags
      if (modalNotesTags) {
        modalNotesTags.innerHTML = product.notes.map(n => `
          <span class="note-tag">${n}</span>
        `).join('');
      }

      // Populate performance metrics
      if (metricLongevityVal) metricLongevityVal.textContent = product.details?.longevity || 'Excelente';
      if (metricProjectionVal) metricProjectionVal.textContent = product.details?.projection || 'Moderada';
      if (metricIdealTime) metricIdealTime.textContent = product.details?.idealTime || 'Día / Noche';
      if (metricSeason) metricSeason.textContent = product.details?.season || 'Todo el año';

      // Set progress bar widths with a slight delay for transition animation effect
      if (metricLongevityBar) {
        metricLongevityBar.style.width = '0%';
        const longText = product.details?.longevity || '';
        let width = '80%';
        if (longText.includes('Extrema') || longText.includes('Excepcional')) width = '95%';
        else if (longText.includes('Excelente')) width = '85%';
        else if (longText.includes('Duradera')) width = '75%';
        else if (longText.includes('Moderada')) width = '55%';
        setTimeout(() => { metricLongevityBar.style.width = width; }, 100);
      }

      if (metricProjectionBar) {
        metricProjectionBar.style.width = '0%';
        const projText = product.details?.projection || '';
        let width = '75%';
        if (projText.includes('Poderosa') || projText.includes('Estela Pesada')) width = '95%';
        else if (projText.includes('Marcada')) width = '85%';
        else if (projText.includes('Moderada')) width = '70%';
        else if (projText.includes('Fresca')) width = '60%';
        setTimeout(() => { metricProjectionBar.style.width = width; }, 100);
      }

      // Set Price
      if (modalPrice) modalPrice.textContent = `$${product.price}`;

      // Bind buying button action attributes for WhatsAppCart
      if (modalBuyBtn) {
        modalBuyBtn.setAttribute('data-id', product.id);
        modalBuyBtn.setAttribute('data-name', product.name);
        modalBuyBtn.setAttribute('data-price', product.price.toString());
        modalBuyBtn.setAttribute('data-img', product.image);
        modalBuyBtn.setAttribute('data-notas', product.notes.join(' · '));
      }

      // Open backdrop
      if (productModal) {
        productModal.classList.add('show');
        productModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden'; // block viewport scroll
      }
    };

    const closeProductModal = () => {
      if (productModal) {
        productModal.classList.remove('show');
        productModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = ''; // restore scrolling
      }
    };

    const updateModalGallery = () => {
      if (modalMainImg && modalImages[currentModalImgIdx]) {
        // Apply smooth transition effect
        modalMainImg.style.opacity = '0.3';
        modalMainImg.style.transform = 'scale(0.98)';
        setTimeout(() => {
          modalMainImg.src = modalImages[currentModalImgIdx];
          modalMainImg.style.opacity = '1';
          modalMainImg.style.transform = 'scale(1)';
        }, 150);
      }

      // Update thumbnails grid
      if (modalThumbnails) {
        modalThumbnails.innerHTML = modalImages.map((img, idx) => `
          <div class="popup-thumbnail ${idx === currentModalImgIdx ? 'active' : ''}" data-idx="${idx}">
            <img src="${img.replace('w=600', 'w=200')}" alt="Miniatura ${idx + 1}" />
          </div>
        `).join('');

        // Bind clics to thumbnails
        modalThumbnails.querySelectorAll('.popup-thumbnail').forEach(thumb => {
          thumb.addEventListener('click', (e) => {
            const el = e.currentTarget as HTMLElement;
            currentModalImgIdx = parseInt(el.dataset.idx || '0');
            updateModalGallery();
          });
        });
      }
    };

    // Card click opening modal triggers
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // Ignorar clic si ocurre sobre el botón COMPRAR de la tarjeta
        if (target.closest('.add-btn')) {
          return;
        }
        const productId = card.dataset.id;
        if (productId) {
          openProductModal(productId);
        }
      });
    });

    // Arrow controls triggers
    if (galleryPrevBtn) {
      galleryPrevBtn.addEventListener('click', () => {
        currentModalImgIdx = (currentModalImgIdx - 1 + modalImages.length) % modalImages.length;
        updateModalGallery();
      });
    }

    if (galleryNextBtn) {
      galleryNextBtn.addEventListener('click', () => {
        currentModalImgIdx = (currentModalImgIdx + 1) % modalImages.length;
        updateModalGallery();
      });
    }

    // Close button triggers
    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', closeProductModal);
    }

    // Close modal when clicking on backdrop shadow
    if (productModal) {
      productModal.addEventListener('click', (e) => {
        if (e.target === productModal) {
          closeProductModal();
        }
      });
    }

    // Close modal when pressing Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && productModal?.classList.contains('show')) {
        closeProductModal();
      }
    });

    // Close modal when modalBuyBtn is clicked (after a delay for cart drawer pop and visual feedback)
    if (modalBuyBtn) {
      modalBuyBtn.addEventListener('click', () => {
        setTimeout(closeProductModal, 300);
      });
    }
  });
</script>
