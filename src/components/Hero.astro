---
---
<section class="hero-section">
  <!-- Dynamic aroma/smoke background animation -->
  <div class="aroma-bg">
    <div class="aroma-cloud cloud-1"></div>
    <div class="aroma-cloud cloud-2"></div>
    <div class="aroma-cloud cloud-3"></div>
    
    <!-- Floating luxury gold sparks/embers matching mockup -->
    <div class="embers-container">
      <div class="ember ember-1"></div>
      <div class="ember ember-2"></div>
      <div class="ember ember-3"></div>
      <div class="ember ember-4"></div>
      <div class="ember ember-5"></div>
      <div class="ember ember-6"></div>
      <div class="ember ember-7"></div>
    </div>
  </div>

  <div class="hero-grid reveal">
    <!-- Left Column (Premium Typography & Interactive Actions) -->
    <div class="hero-content">
      <span class="hero-tag">COLECCIÓN EXCLUSIVA DE AUTOR</span>
      <h1 class="hero-title">
        El Lujo que puedes sentir,<br>
        el <em class="gold-text">Aroma</em> que permanece.
      </h1>
      <p class="hero-subtitle">
        Boutique de perfumes de autor creados cuidadosamente para quienes buscan un aroma inolvidable. Profundos y mezclas magistrales diseñadas para inseparables en tu rutina diaria de bienestar.
      </p>
      <div class="hero-actions">
        <a href="#products" class="hero-btn primary-btn">EXPLORAR CATÁLOGO</a>
        <a href="#" id="heroContactBtn" class="hero-btn outline-btn">CONTACTAR ASESOR</a>
      </div>
    </div>

    <!-- Right Column (Luxury Showcase) -->
    <div class="hero-showcase">
      <div class="hero-image-wrapper">
        <div class="perfume-container" id="perfumeContainer">
          <!-- Luxury Matte Black Box behind the bottle (matching Dior Sauvage box exactly) -->
          <div class="luxury-box">
            <div class="box-brand">SAUVAGE</div>
            <div class="box-subtitle">EAU DE TOILETTE</div>
            <div class="box-dior">Dior</div>
          </div>

          <!-- Dior Sauvage Photo Card (Pristine & Static) -->
          <div class="sauvage-card">
            <img src="/sauvage.png" alt="Dior Sauvage" id="sauvage-bottle-img" class="sauvage-img" />
          </div>

          <!-- Wet basalt/volcanic rock pedestal under the bottle -->
          <div class="pedestal-container">
            <div class="rock-pedestal"></div>
            <div class="pedestal-shadow"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 95vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 120px 80px 60px;
    /* Dark navy blue to deep black radial gradient centered behind bottle, matching mockup */
    background: radial-gradient(circle at 75% 50%, #0c1827 0%, #03060a 70%);
    overflow: hidden;
    /* Luxury gold top line border matching mockup */
    border-top: 1px solid rgba(201, 169, 110, 0.4);
    border-bottom: 1px solid rgba(201, 169, 110, 0.1);
  }

  /* Subtle lighting reflections to elevate the background */
  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 15% 30%, rgba(201, 169, 110, 0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 1;
  }

  /* Dynamic aroma/smoke background animation */
  .aroma-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .aroma-cloud {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.18;
    mix-blend-mode: screen;
    animation: aromaDrift 20s ease-in-out infinite alternate;
  }

  /* Cold, greyish-blue fog/smoke clouds matching Sauvage image */
  .cloud-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(74, 112, 155, 0.16) 0%, transparent 70%);
    top: 5%;
    right: 5%;
    animation-duration: 22s;
    animation-delay: 0s;
  }

  .cloud-2 {
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(28, 48, 74, 0.22) 0%, transparent 70%);
    bottom: -15%;
    right: -10%;
    animation-duration: 28s;
    animation-delay: -5s;
  }

  .cloud-3 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(98, 131, 168, 0.1) 0%, transparent 70%);
    top: 25%;
    left: 45%;
    animation-duration: 16s;
    animation-delay: -2s;
  }

  /* Smooth organic drifting and shape morphing */
  @keyframes aromaDrift {
    0% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 0.12;
    }
    33% {
      transform: translate(60px, -60px) scale(1.15) rotate(45deg);
      opacity: 0.2;
    }
    66% {
      transform: translate(-30px, 30px) scale(0.9) rotate(-30deg);
      opacity: 0.08;
    }
    100% {
      transform: translate(40px, -40px) scale(1.05) rotate(20deg);
      opacity: 0.16;
    }
  }

  /* Floating luxury gold sparks/embers */
  .embers-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }

  .ember {
    position: absolute;
    background: #ff9b36;
    border-radius: 50%;
    filter: drop-shadow(0 0 5px #ff5900) blur(0.5px);
    opacity: 0;
    animation: floatEmber infinite linear;
  }

  .ember-1 { left: 10%; top: 40%; width: 2px; height: 2px; animation-duration: 14s; animation-delay: 0s; }
  .ember-2 { left: 22%; top: 20%; width: 3px; height: 3px; animation-duration: 10s; animation-delay: -3s; }
  .ember-3 { left: 35%; top: 55%; width: 2px; height: 2px; animation-duration: 18s; animation-delay: -6s; }
  .ember-4 { left: 45%; top: 30%; width: 3px; height: 3px; animation-duration: 12s; animation-delay: -2s; }
  .ember-5 { right: 12%; bottom: 20%; width: 4px; height: 4px; animation-duration: 8s; animation-delay: -1s; }
  .ember-6 { right: 25%; bottom: 35%; width: 2px; height: 2px; animation-duration: 11s; animation-delay: -4s; }
  .ember-7 { right: 38%; bottom: 15%; width: 3px; height: 3px; animation-duration: 15s; animation-delay: -7s; }

  @keyframes floatEmber {
    0% {
      transform: translateY(60px) translateX(0) scale(0.6);
      opacity: 0;
    }
    15% {
      opacity: 0.8;
    }
    85% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(-120px) translateX(30px) scale(1.2);
      opacity: 0;
    }
  }

  .hero-grid {
    width: 100%;
    max-width: 1360px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 80px;
    position: relative;
    z-index: 10;
  }

  /* Left column: left-aligned typography exactly matching mockup */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-tag {
    font-family: 'Geist', sans-serif;
    font-size: 11px;
    letter-spacing: 0.35em;
    color: var(--gold-light);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 24px;
    opacity: 0.95;
    display: inline-block;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 400;
    line-height: 1.18;
    color: var(--white);
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }

  .hero-title .gold-text {
    font-style: italic;
    color: var(--gold-light);
    font-weight: 400;
  }

  .hero-subtitle {
    font-family: 'Geist', sans-serif;
    font-size: 15px;
    color: #a0a0a0;
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 40px;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    width: 100%;
  }

  /* Right column: luxury showcase pedestal and box */
  .hero-showcase {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1 / 1.05;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .perfume-container {
    position: relative;
    width: 100%;
    max-width: 320px;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default; /* Non-interactive static display */
    transition: transform 0.4s cubic-bezier(.16, 1, .3, 1);
    animation: floatUpDown 6s ease-in-out infinite;
  }

  .perfume-container:hover {
    transform: scale(1.03);
  }

  .sauvage-card {
    position: relative;
    width: 100%;
    aspect-ratio: 400 / 500;
    overflow: visible;
    border-radius: 4px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .sauvage-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    pointer-events: none;
  }

  /* Luxury Matte Black Box behind the bottle (matching Dior Sauvage box exactly) */
  .luxury-box {
    position: absolute;
    right: -75px;
    top: 8%;
    width: 210px;
    height: 290px;
    background: linear-gradient(135deg, #0e1116 0%, #06080a 100%);
    border: 1px solid rgba(255, 255, 255, 0.03);
    box-shadow: 
      -20px 30px 60px rgba(0, 0, 0, 0.95), 
      inset 0 0 20px rgba(255, 255, 255, 0.01);
    z-index: -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 35px 24px;
    box-sizing: border-box;
    transform: perspective(1000px) rotateY(-18deg) rotateX(6deg) rotateZ(-1deg);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 2px;
  }

  .perfume-container:hover .luxury-box {
    transform: perspective(1000px) rotateY(-12deg) rotateX(4deg) rotateZ(0deg) scale(1.02);
  }

  .box-brand {
    font-family: 'Playfair Display', serif;
    font-size: 21px;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.22em;
    margin-top: 40px;
    margin-bottom: 4px;
    font-weight: 500;
    text-align: center;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .box-subtitle {
    font-family: 'Geist', sans-serif;
    font-size: 7.5px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-align: center;
    font-weight: 500;
  }

  .box-dior {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.5);
    position: absolute;
    bottom: 35px;
    text-align: center;
    letter-spacing: 0.05em;
    width: 100%;
  }

  /* Rocky pedestal matching mockup volcanic stone */
  .pedestal-container {
    position: absolute;
    bottom: -32px;
    left: 50%;
    transform: translateX(-50%);
    width: 115%;
    height: 70px;
    z-index: -2;
    pointer-events: none;
    overflow: visible;
  }

  .rock-pedestal {
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at top, #1c222a 0%, #080a0d 100%);
    border-radius: 50% / 24%;
    box-shadow: 
      0 12px 35px rgba(0,0,0,0.95), 
      inset 0 2px 5px rgba(255,255,255,0.04);
    border-top: 1.5px solid rgba(255, 255, 255, 0.08);
    position: relative;
  }

  /* Extra rocky edge layer to give basalt structure */
  .rock-pedestal::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 2%;
    width: 96%;
    height: 30px;
    background: #050608;
    border-radius: 50% / 30%;
    box-shadow: 0 10px 20px rgba(0,0,0,0.95);
    z-index: -1;
  }

  .pedestal-shadow {
    position: absolute;
    bottom: -45px;
    left: 5%;
    width: 90%;
    height: 35px;
    background: radial-gradient(ellipse, rgba(0,0,0,0.85) 0%, transparent 70%);
    filter: blur(15px);
    z-index: -3;
  }

  /* Dynamic floating animation for luxury card */
  @keyframes floatUpDown {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Symmetrical Rectangular High Fashion Buttons matching mockup */
  .hero-btn {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px;
    letter-spacing: 0.2em;
    padding: 16px 36px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(.16, 1, .3, 1);
    border-radius: 0px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .primary-btn {
    color: var(--black);
    background: #c9a96e;
    border: none;
    box-shadow: 0 6px 20px rgba(201, 169, 110, 0.15);
    font-weight: 700;
  }

  .primary-btn:hover {
    background: #d8ba82;
    box-shadow: 0 10px 30px rgba(201, 169, 110, 0.35);
    transform: translateY(-2px);
  }

  .outline-btn {
    color: var(--white);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .outline-btn:hover {
    color: var(--gold-light);
    border-color: var(--gold-light);
    background: rgba(201, 169, 110, 0.04);
    transform: translateY(-2px);
  }

  /* Responsive styling for screen stacking */
  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .hero-section {
      min-height: auto;
      padding: 120px 24px 60px;
    }
    .hero-content {
      text-align: center;
      align-items: center;
    }
    .hero-actions {
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero-subtitle {
      max-width: 600px;
    }
    .hero-image-wrapper {
      max-width: 320px;
      margin: 15px auto;
    }
    .luxury-box {
      right: -30px;
      width: 180px;
      height: 250px;
      padding: 20px;
    }
    .box-brand {
      font-size: 15px;
    }
    .box-details {
      bottom: 25px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Bind Hero contact button to open WhatsApp panel
    const heroContactBtn = document.getElementById('heroContactBtn');
    if (heroContactBtn) {
      heroContactBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const waFab = document.getElementById('waFab');
        if (waFab) {
          waFab.click();
        }
      });
    }
  });
</script>
